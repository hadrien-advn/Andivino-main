# Copier ce fichier en .env et renseigner les valeurs depuis le Dashboard Stripe.
# Ne jamais commiter .env.
# Les cles secretes collees dans une conversation doivent etre revoquees/regenerees.

PORT=4242
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# CRM Andivino : inscriptions newsletter et commandes payees (secrets partages, memes valeurs sur Vercel).
